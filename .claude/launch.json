{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tradinghub",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tradinghub-analytics",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3107"],
      "port": 3107
    },
    {
      "name": "tradinghub-webpack",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--webpack"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
