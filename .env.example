# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# !! NEVER put the service_role key in any NEXT_PUBLIC_* var

# ── App mode ─────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=false

# ── Email (SMTP) ─────────────────────────────────────────────────────
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_HOOK_SECRET=
HOOK_ENDPOINT_SECRET=

# ── Global Markets Intelligence ──────────────────────────────────────
# Server-side only. Never prefix these with NEXT_PUBLIC_ — that would ship
# them to the browser. They are read exclusively inside /src/app/api routes.
#
# FRED  — macro rates, yield curve, real yields, Fed balance sheet,
#         reserves, RRP, TGA, M1/M2.  https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Marketaux — financial news with sentiment / relevance / entity tagging.
#         https://www.marketaux.com  (free tier: 100 requests/day)
MARKETAUX_API_KEY=
# Twelve Data — earnings calendar + estimates/actuals, and a reliable
#         quote/time-series source.  https://twelvedata.com
#         (free tier: 8 requests/min, 800/day — cache aggressively)
TWELVEDATA_API_KEY=
